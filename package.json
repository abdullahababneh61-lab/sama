{
  "name": "sama-design-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sama (سما) in-platform design workspace: a browser-based vector + raster design editor for structured design exercises.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@erase2d/fabric": "^1.2.1",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "fabric": "^7.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
